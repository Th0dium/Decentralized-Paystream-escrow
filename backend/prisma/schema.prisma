// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  wallet     String   @unique
  isCompany  Boolean  @default(false)
  isEmployee Boolean  @default(false)
  isAuditor  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([wallet])
}

model Payment {
  id                  Int      @id @default(autoincrement())
  paymentId           Int      @unique
  company             String
  employee            String
  token               String
  totalAmount         String // Store as string (big numbers)
  startTime           BigInt
  stopTime            BigInt
  lastWithdrawTime    BigInt?
  withdrawn           String   @default("0")
  paused              Boolean  @default(false)
  cancelled           Boolean  @default(false)
  totalPausedDuration BigInt   @default(0)
  pausedAt            BigInt?  @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  escrows Escrow[]

  @@index([company])
  @@index([employee])
}

model Escrow {
  id          Int      @id @default(autoincrement())
  escrowId    Int      @unique
  paymentId   Int?
  company     String
  employee    String
  token       String
  amount      String
  description String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, CLAIMED, CANCELLED
  createdAt   DateTime @default(now())
  approvedAt  DateTime?
  claimedAt   DateTime?
  updatedAt   DateTime @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [paymentId])

  @@index([paymentId])
  @@index([company])
  @@index([employee])
  @@index([status])
}

model ContractEvent {
  id              Int      @id @default(autoincrement())
  eventName       String // PaymentCreated, PaymentWithdrawn, EscrowCreated, etc.
  blockNumber     Int
  transactionHash String   @unique
  data            Json // Store full event data as JSON
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([eventName])
  @@index([processed])
}
